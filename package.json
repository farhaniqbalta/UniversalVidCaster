{
  "name": "universal-vid-caster",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "bridge:hls": "node spikes/hls-manifest-bridge/server.mjs",
    "test:bridge": "node --test spikes/hls-manifest-bridge/playlist.test.mjs",
    "dev": "npm run dev -w @uvc/harness",
    "build": "npm run build -w @uvc/harness",
    "typecheck": "tsc -p packages/core && tsc -p packages/cast-web && tsc -p packages/detector && tsc -p apps/web-test-harness && tsc -p spikes/safari-google-cast",
    "test": "vitest run",
    "build:safari-probe": "node spikes/safari-google-cast/build-extension.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "@types/chromecast-caf-sender": "^1.0.11",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
